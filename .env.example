# ============================================================
#  SparBit - Konfiguration
#  Kopieren nach .env und ausfuellen:  cp .env.example .env
#  .env wird NICHT committet (siehe .gitignore).
# ============================================================

# ============================================================
#  Diese Datei ist OPTIONAL.
#  Fuer den Start auf dem eigenen Rechner (python run.py) brauchst du
#  hier gar nichts - Telegram und API-Keys traegst du bequem im Web-UI
#  ein. Diese Datei ist vor allem fuer den Docker-Betrieb da.
# ============================================================

# --- Grundlagen ---------------------------------------------------------
# Port, auf dem das Web-UI erreichbar ist (nur Docker;
# lokal steuert das "python run.py --port 9000").
SPARBIT_WEB_PORT=8080

# --- HTTPS (optional, empfohlen auf dem VPS) ----------------------------
# Traegst du hier eine Domain ein, startet "docker compose --profile https up"
# zusaetzlich Caddy. Das Zertifikat holt und erneuert es selbst; du musst nur
# dafuer sorgen, dass der A-Record der Domain auf diesen Server zeigt.
# install.sh fragt das ab und traegt es hier ein.
SPARBIT_DOMAIN=
# E-Mail fuer Let's Encrypt (optional - dient nur Ablaufwarnungen).
SPARBIT_ACME_MAIL=
# An welche Adresse der Frontend-Port gebunden wird.
# 0.0.0.0     = direkt aus dem Netz erreichbar
# 127.0.0.1   = nur lokal - richtig, sobald ein Reverse-Proxy davorsteht,
#               egal ob der mitgelieferte Caddy oder ein schon vorhandener
SPARBIT_WEB_BIND=0.0.0.0

# --- Preisfehler-Waechter -----------------------------------------------
# Meldet Preisfehler sofort und unabhaengig von Regeln und Ruhezeiten.
# Feiner einstellen laesst sich das im Web-UI unter "Preisfehler" -
# hier steht nur, was beim allerersten Start gilt.

# Zeitzone der Container (wichtig fuer Ruhezeiten und Claimer-Zeitplan).
TZ=Europe/Berlin

# Gemeinsames Geheimnis zwischen Web-UI und dem Update-Skript auf dem Host.
# Nur wenn es gesetzt ist, gibt es im UI unter "Logs & System" den Bereich
# "Updates" mit Knopf und Automatik. install.sh legt es an; von Hand:
#   openssl rand -hex 32
# Nach einer Aenderung:  ./sparbit neustart backend
SPARBIT_UPDATE_TOKEN=

# Signaturschluessel fuer Session-Cookies.
# Leer lassen -> wird beim ersten Start erzeugt und in der DB gespeichert.
# Eigenen setzen mit:  openssl rand -base64 48
SPARBIT_SECRET_KEY=

# --- Logging & Aufbewahrung --------------------------------------------
SPARBIT_LOG_LEVEL=INFO
SPARBIT_LOG_JSON=true
SPARBIT_DEAL_RETENTION_DAYS=60
SPARBIT_LOG_RETENTION_DAYS=14

# --- Hoefliches Crawling ------------------------------------------------
# Eigener User-Agent - bitte mit gueltiger Kontaktmoeglichkeit versehen.
SPARBIT_USER_AGENT=SparBit/1.0 (self-hosted deal monitor; +https://github.com/StrikerLUL/spar_bit)
# Mindestabstand zwischen zwei Requests an denselben Host (Sekunden).
SPARBIT_PER_HOST_DELAY=1.0
SPARBIT_HTTP_TIMEOUT=25

# --- Circuit Breaker ----------------------------------------------------
# Nach wie vielen Fehlern in Folge wird eine Quelle pausiert ...
SPARBIT_BREAKER_THRESHOLD=5
# ... und fuer wie lange (Sekunden).
SPARBIT_BREAKER_COOLDOWN=1800

# --- Telegram-Bot -------------------------------------------------------
# Lauscht auf die Knoepfe unter den Meldungen ("gemerkt", "Quelle stumm")
# und auf Befehle wie /neueste. Nutzt Long Polling, braucht also KEINEN
# offenen Port - funktioniert auch hinter dem Router zu Hause.
SPARBIT_TELEGRAM_POLLING=true

# --- Wo die Daten liegen ------------------------------------------------
# Normalerweise nicht noetig: lokal ./data, im Container /data.
# SPARBIT_DATA_DIR=/eigener/pfad

# ============================================================
#  API-Keys
#  Optional - die Quellen laufen auch ohne, sind dann aber aus.
#  Eintragen kannst du sie auch direkt im Web-UI unter "Quellen".
#  Nur hier noetig, wenn du tools/verify_endpoints.py nutzt.
# ============================================================

# IsThereAnyDeal - Key: https://isthereanydeal.com/apps/my/
SPARBIT_KEY_ITAD=

# GG.deals - Zugang beantragen: https://gg.deals/de/api/
SPARBIT_KEY_GGDEALS=

# ============================================================
#  Auto-Claimer (vogler/free-games-claimer)
#  Anmeldedaten der Spiele-Konten. Bleiben auf deinem Server.
#  Leer lassen = die jeweilige Plattform wird uebersprungen.
#  Beim ersten Start ggf. interaktiv anmelden, siehe README.
# ============================================================

# Epic Games
EG_EMAIL=
EG_PASSWORD=
# Optional: TOTP-Secret fuer 2FA (nicht der 6-stellige Code!)
EG_OTPKEY=

# Amazon Prime Gaming
PG_EMAIL=
PG_PASSWORD=
PG_OTPKEY=

# GOG
GOG_EMAIL=
GOG_PASSWORD=

# Zeitplan des Claimers (Cron-Syntax, Zeitzone siehe TZ oben).
CLAIMER_SCHEDULE=0 4 * * *

# Benachrichtigung des Claimers selbst (optional, via apprise/notify).
# Beispiel Telegram:  tgram://BOT_TOKEN/CHAT_ID
NOTIFY=

# ============================================================
#  Hinweis Telegram
#  Bot-Token und Chat-ID werden NICHT hier eingetragen, sondern
#  im Web-UI unter "Benachrichtigungen" - dort landen sie in der DB
#  und koennen ohne Neustart geaendert werden.
#  Token holen:  @BotFather  ->  /newbot
#  Chat-ID:      @userinfobot anschreiben
# ============================================================

# --- Netzschutz ------------------------------------------------------------
# SparBit ruft von sich aus nichts im eigenen Netz ab: keine Adresse, die auf
# localhost, 192.168.x.x, 10.x.x.x oder 169.254.169.254 (Cloud-Metadaten)
# zeigt - auch nicht ueber eine Weiterleitung. Benachrichtigungs-Kanaele sind
# ausgenommen, ein Gotify im Heimnetz ist der Normalfall.
# Wer bewusst einen Feed oder Shop aus dem eigenen Netz beobachten will,
# schaltet die Pruefung hiermit ab.
#SPARBIT_ERLAUBE_PRIVATE_ZIELE=false

# --- Eigene Quellen und Kanaele -------------------------------------------
# Jede .py-Datei in diesem Ordner wird beim Start geladen. Damit laesst sich
# eine eigene Quelle betreiben, ohne SparBit zu forken - Aufbau wie in
# backend/app/sources/. Was dort liegt, laeuft mit allen Rechten des
# Prozesses; ohne gesetzten Pfad wird nichts geladen.
#SPARBIT_PLUGIN_DIR=/data/plugins

# --- Andere Datenbank ------------------------------------------------------
# Leer heisst SQLite im Datenverzeichnis - der Normalfall. Wer die Daten
# lieber in einem vorhandenen Postgres haelt, traegt dessen Adresse ein.
# Die Volltextsuche faellt dort automatisch auf LIKE zurueck.
#SPARBIT_DB_URL_OVERRIDE=postgresql+psycopg://sparbit:geheim@db/sparbit
