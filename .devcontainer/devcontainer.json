// Vom Klon zum laufenden SparBit, ohne vorher Python-Versionen zu sortieren.
// Funktioniert in GitHub Codespaces und in VS Code mit der Dev-Containers-
// Erweiterung.
//
// Bewusst ohne Docker-in-Docker: hier wird entwickelt und getestet, nicht
// das Produktions-Compose nachgestellt. Wer das braucht, nimmt einen VPS.
{
  "name": "SparBit",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },

  // Beides einrichten: Backend in .venv, Oberflaeche in frontend/node_modules.
  // Danach laeuft "python run.py --dev" ohne weitere Schritte.
  "postCreateCommand": "bash .devcontainer/einrichten.sh",

  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "SparBit Backend", "onAutoForward": "notify" },
    "5173": { "label": "SparBit Oberflaeche (Vite)", "onAutoForward": "openPreview" }
  },

  "containerEnv": {
    // Im Container ist 127.0.0.1 nicht erreichbar - die Portweiterleitung
    // braucht eine Bindung nach aussen. Das gilt NUR hier.
    "SPARBIT_HOST": "0.0.0.0",
    "SPARBIT_OPEN_BROWSER": "0",
    "SPARBIT_LOG_LEVEL": "DEBUG"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "editor.formatOnSave": false
      }
    }
  }
}
