{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Die Prometheus-Instanz, die /api/metrics abfragt.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "SparBit",
  "description": "Quellen, Funde und Zustellung auf einen Blick. Die Zahlen kommen aus /api/metrics (Prometheus-Textformat, hinter Anmeldung oder API-Token).",
  "tags": [
    "sparbit",
    "deals"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Läuft es?",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Deals gesamt",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sparbit_deals_gesamt",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Neue Deals (24 h)",
      "description": "Flacht diese Zahl über Tage ab, liefert meist eine Quelle nicht mehr - die Tabelle unten sagt welche.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "sparbit_deals_24h",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Aktive Quellen",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "count(sparbit_quelle_eingeschaltet == 1)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Gesperrte Quellen",
      "description": "Schutzschalter: nach fünf Fehlern in Folge pausiert eine Quelle. Ein Wert über 0 über Stunden hinweg ist ein echter Ausfall, kein Ausrutscher.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "count(sparbit_quelle_gesperrt == 1) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Fehlerquote der Läufe (24 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "100 * sum(increase(sparbit_quelle_fehler_gesamt[24h])) / clamp_min(sum(increase(sparbit_quelle_laeufe_gesamt[24h])), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Alter der Wechselkurse",
      "description": "Der einzige Fehler in SparBit, der sich nie von selbst meldet: veraltete Kurse lassen Preisgrenzen bei Fremdwährungen leise danebengreifen. -1 heißt: noch nie geholt.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "sparbit_kurse_alter_tage",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      }
    },
    {
      "type": "row",
      "title": "Quellen",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Gelieferte Einträge je Quelle (pro Stunde)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (quelle) (increase(sparbit_quelle_eintraege_gesamt[1h]))",
          "legendFormat": "{{quelle}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Fehlgeschlagene Läufe je Quelle (pro Stunde)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (quelle) (increase(sparbit_quelle_fehler_gesamt[1h]))",
          "legendFormat": "{{quelle}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "type": "table",
      "title": "Zustand je Quelle",
      "description": "Eine Zeile je eingeschalteter Quelle: wie viele Läufe, wie viele Fehler, wie lange der letzte Erfolg her ist.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sparbit_quelle_laeufe_gesamt",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "sparbit_quelle_fehler_gesamt",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "sparbit_quelle_eintraege_gesamt",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "sparbit_quelle_sekunden_seit_erfolg",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "quelle",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "__name__ 4": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "instance 4": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "job 4": true
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Zustellung",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "type": "timeseries",
      "title": "Zugestellte Meldungen je Kanal (24-h-Fenster)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (kanal) (sparbit_meldungen_24h)",
          "legendFormat": "{{kanal}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Fehlgeschlagene Zustellungen je Kanal (24-h-Fenster)",
      "description": "Über null bedeutet fast immer: ein Token ist abgelaufen oder ein Webhook existiert nicht mehr. Der Versandverlauf im UI nennt den Grund im Klartext.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (kanal) (sparbit_meldungen_fehler_24h)",
          "legendFormat": "{{kanal}}",
          "refId": "A"
        }
      ]
    }
  ]
}
