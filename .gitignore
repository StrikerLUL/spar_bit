# Secrets - NIEMALS committen
.env
*.env
!.env.example

# Daten (lokaler Start legt ./data an)
data/
claimer-data/
.venv/
*.db
*.db-wal
*.db-shm
backups/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Messdatei von pytest-cov - entsteht bei jedem Lauf neu.
.coverage
.coverage.*
htmlcov/
*.egg-info/

# Node
node_modules/
.vite/
*.tsbuildinfo

# Gebaute Oberflaeche gehoert nicht in die Versionsverwaltung: minifizierte
# Bundles erzeugen unlesbare Unterschiede und Konflikte bei jedem Commit.
# Wer kein Node hat, bekommt sie fertig - run.py holt das Archiv aus dem
# letzten Release (Workflow .github/workflows/release.yml).
frontend/dist/
/dist/
backend/dist/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Live-Fixtures (koennen personalisierte Daten enthalten)
backend/tests/fixtures/live/

# Arbeitsverzeichnis des Auto-Updaters (Sperre, Protokoll, Sicherung)
.update/

# Playwright: Bericht, Spuren und die Wegwerf-Datenbank des Durchstichs.
frontend/playwright-report/
frontend/test-results/
frontend/.e2e-daten/
frontend/e2e/.auth/
frontend/coverage/

# Das OpenAPI-Schema ist ein Zwischenschritt: erzeugt aus dem Backend,
# verbraucht von openapi-typescript. Eingecheckt wird das Ergebnis
# (src/lib/api-typen.ts), damit die CI vergleichen kann - die Zwischenform
# waere nur ein zweiter Ort, an dem dasselbe steht.
frontend/openapi.json
